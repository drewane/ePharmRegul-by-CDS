venv/
__pycache__/
*.py[cod]
instance/*.db-journal
*.log
.DS_Store
instance/*.avant-migration-*

# Fichiers téléversés par les utilisateurs : données, pas code source
static/documents/
static/certificats/

# Secrets locaux — ne doivent jamais entrer dans le dépôt
instance/cle_secrete.txt
instance/IDENTIFIANTS-PRIVES.txt

# Binaire du tunnel (52 Mo) — retéléchargeable, pas du code source
outils/
instance/*.avant-vidage-*

# Actes générés à la demande : reproductibles depuis la base, jamais versionnés.
instance/actes/

# Un fichier d identifiants renomme restait versionnable : on couvre le prefixe,
# pas le nom exact.
instance/IDENTIFIANTS-PRIVES*
instance/*.durcie-*
